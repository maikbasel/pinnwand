{
  "name": "pinnwand",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.0.0 <24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "check": "ultracite check",
    "check-types": "tsc -b --noEmit",
    "fix": "ultracite fix",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev:up": "docker compose up -d --wait kong mailpit studio seed",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v",
    "dev:logs": "docker compose logs -f",
    "dev:psql": "docker compose exec db psql -U postgres",
    "seed:dev": "docker compose run --rm --build seed",
    "db:migration:new": "supabase migration new",
    "db:push": "supabase db push --db-url postgresql://postgres:postgres@localhost:5432/postgres --include-all",
    "db:reset": "supabase db reset --db-url postgresql://postgres:postgres@localhost:5432/postgres",
    "db:types": "supabase gen types typescript --db-url postgresql://postgres:postgres@localhost:5432/postgres > src/shared/types/database.ts",
    "e2e": "pnpm e2e:up && pnpm e2e:test",
    "e2e:up": "docker compose -f docker-compose.e2e.yml up --build -d --wait db migrate kong auth rest realtime mailpit web",
    "e2e:test": "docker compose -f docker-compose.e2e.yml up --exit-code-from playwright playwright",
    "e2e:logs": "docker compose -f docker-compose.e2e.yml logs web auth rest realtime migrate",
    "e2e:down": "docker compose -f docker-compose.e2e.yml down -v",
    "e2e:chromium": "PLAYWRIGHT_ARGS='--project=chromium' pnpm e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@supabase/supabase-js": "2.105.3",
    "@tanstack/query-async-storage-persister": "5.100.9",
    "@tanstack/react-query": "5.100.9",
    "@tanstack/react-query-persist-client": "5.100.9",
    "@tanstack/react-router": "1.169.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.1.0",
    "idb-keyval": "^6.2.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-swipeable": "^7.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "use-long-press": "^3.3.0",
    "vaul": "^1.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "4.2.4",
    "@tanstack/router-plugin": "1.167.35",
    "@testcontainers/postgresql": "^11.14.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "dotenv": "^17.4.2",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "knip": "6.12.1",
    "postgres": "^3.4.9",
    "shadcn": "^4.13.0",
    "supabase": "2.98.2",
    "tailwindcss": "4.2.4",
    "testcontainers": "^11.14.0",
    "typescript": "6.0.3",
    "ultracite": "7.6.4",
    "vite": "8.1.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "esbuild",
      "@biomejs/biome",
      "@tailwindcss/oxide",
      "unrs-resolver",
      "sharp"
    ]
  }
}
