# Copy to `.env`. For local dev the frontend runs on the host (`pnpm dev`) and
# talks to the self-hosted Supabase stack (docker-compose.yml) through kong on
# :8000. The values below are the public Supabase self-host demo keys, so this
# works out of the box after `pnpm dev:up`.
#
# Vite reads this file from the app root (apps/web); Playwright's config reads it
# via dotenv from the same cwd. Production deployment vars live in the repo-root
# .env.example instead.
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.b_lMH2mc5km7S9Lw_sRGGqE9IeiahYu-caevDcacKiY
