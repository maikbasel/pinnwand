# Copy to `.env`. `pnpm dev` loads it automatically (tsx --env-file-if-exists).
# The values below are the public Supabase self-host demo keys, so the server
# talks to the local stack (docker-compose.yml, kong on :8000) out of the box
# after `pnpm dev:up`. Never put real secrets here; `.env` is gitignored and
# production sets these vars through the deploy environment instead.

# Kong gateway for the local Supabase stack. supabase-js appends /rest/v1 and
# /auth/v1 to this.
SUPABASE_URL=http://localhost:8000

# Public anon key. Sent as the `apikey` header; kong validates it.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.b_lMH2mc5km7S9Lw_sRGGqE9IeiahYu-caevDcacKiY

# Shared HS256 secret self-hosted GoTrue signs user JWTs with (GOTRUE_JWT_SECRET).
# The server verifies caller tokens against it. Leave unset on Supabase Cloud,
# which signs asymmetrically and publishes a JWKS.
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Public URL of this server. Goes into the OAuth protected-resource metadata.
MCP_PUBLIC_URL=http://localhost:8787

# Port this server listens on.
PORT=8787
